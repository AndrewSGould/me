{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heyroo-dev",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "heyroo.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
